# Copie para .env. NÃO inclua .env em arquivos compartilhados.
# Use exatamente o endereço que será acessado, sem barra final.
NJA_ORIGIN=http://localhost:8000
NJA_DATA=/var/lib/nja
# Configure em produção: HTTPS, SMTP e VAPID.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:SEU_EMAIL
# Integrações da versão 1.3. Credenciais vazias desativam o serviço externo.
OPENAI_API_KEY=
OPENAI_PROJECT=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
NJA_AI_DAILY_LIMIT=300
NJA_AI_USER_DAILY_LIMIT=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_DRIVE_ROOT_ID=
# Opcional: array JSON de servidores ICE com TURN para redes diferentes.
# NJA_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:SEU_SERVIDOR:3478","username":"USUARIO","credential":"SENHA"}]
# Sem NJA_TOKEN_KEY, uma chave privada é criada no volume de dados.
# Preserve integration.key nos backups.
# Recuperação de senha: starttls (normalmente 587) ou ssl (normalmente 465).
SMTP_SECURITY=starttls

# Clima por unidade: Current Weather + 5 day / 3 hour forecast, OpenWeather.
OPENWEATHER_API_KEY=

# NJA 1.8 — Cora: somente consulta. Comece em stage e valide antes de production.
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_PATH=
CORA_KEY_PATH=
# Meta: versão suportada pelo app, por exemplo a indicada no painel Meta Developers.
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ID=
META_AD_ACCOUNT_ID=
# WhatsApp Cloud API: webhook HTTPS /webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Destino externo montado para backup diário; vazio desativa a rotina.
NJA_BACKUP_DIR=

# ID da conta WhatsApp Business para consulta de templates aprovados.
WHATSAPP_BUSINESS_ID=

# ZapSign: mantenha o token somente no ambiente do servidor.
ZAPSIGN_ENV=production
ZAPSIGN_API_TOKEN=
