<Window x:Class="NjaSystem.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NJA System" Width="1360" Height="860" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#101820">
  <Grid>
    <wv2:WebView2 x:Name="Browser" />
    <Border x:Name="LoadingPanel" Background="#101820">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/app.ico" Width="86" Height="86" />
        <TextBlock Text="NJA System" Foreground="White" FontSize="26" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,20,0,6" />
        <TextBlock Text="Abrindo seu espaço de trabalho…" Foreground="#A7BBC9" FontSize="14"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
